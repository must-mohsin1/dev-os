#!/usr/bin/env bash
# devos-improve — propose the highest-value improvement for a repo (research + plan, NO build).
#   devos-improve /path/to/repo
# Reuses researcher + planner to produce an improvement brief + spec, files a board goal, and
# posts a 1-3-1 for the human. Approving = running:  devos-run "<the improvement>" <repo>
# Designed to run on a cron (nightly retro).
set -euo pipefail
REPO="${1:-}"; [ -n "$REPO" ] || { echo "usage: devos-improve <repo>"; exit 2; }
command -v hermes >/dev/null 2>&1 || { echo "hermes not found" >&2; exit 1; }
RABS="$(cd "$REPO" 2>/dev/null && pwd || true)"; [ -n "$RABS" ] || { echo "repo not found: $REPO" >&2; exit 1; }
slug=$(basename "$RABS"); RUN="$HOME/.dev-os-runs/improve-$slug"; mkdir -p "$RUN"
BOARD="${DEVCREW_BOARD:-$(printf '%s' "$slug" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')}"   # per-project board
hermes kanban init >/dev/null 2>&1 || true; hermes kanban boards create "$BOARD" >/dev/null 2>&1 || true
say(){ printf '\033[1;36m▸ %s\033[0m\n' "$*"; }

say "1/3 analyze $RABS for improvements (researcher / Grok)"
hermes -p devos-researcher --yolo -z "Analyze the repository at $RABS (read README, structure, key files) and research current best practices with Grok x_search. Identify the top 1-3 improvement opportunities (bugs, gaps, modernization, performance, security, DX), each with: what, why it matters, evidence/source, rough effort. Write $RUN/improve-brief.md." > "$RUN/r.out" 2>&1 || true
[ -s "$RUN/improve-brief.md" ] || cp "$RUN/r.out" "$RUN/improve-brief.md"

say "2/3 spec the top improvement (planner / Codex)"
plan_spec(){ hermes -p devos-planner --yolo -z "Read $RUN/improve-brief.md. Pick the SINGLE highest-value improvement for $RABS and write an approval-ready spec to $RUN/improve-spec.md (Problem, Goal, Non-goals, Acceptance criteria, Risks). Run your spec-critic pass." > "$RUN/p.out" 2>&1 || true; }
plan_spec
grep -qiE 'acceptance|non-goal' "$RUN/improve-spec.md" 2>/dev/null || { say "  planner produced no spec — retrying once"; plan_spec; }
[ -s "$RUN/improve-spec.md" ] || cp "$RUN/p.out" "$RUN/improve-spec.md"
TITLE=$(grep -m1 -E '^#|Goal:' "$RUN/improve-spec.md" 2>/dev/null | sed 's/^#* *//;s/Goal:* *//' | cut -c1-70 || true)

say "3/3 file proposal + devos summary"
hermes kanban --board "$BOARD" create "improve($slug): ${TITLE:-proposal}" --assignee devos >/dev/null 2>&1 || true
hermes -p devos --yolo -z "An improvement proposal for '$slug' is ready (brief: $RUN/improve-brief.md, spec: $RUN/improve-spec.md). Post a 1-3-1 decision brief to the human: the problem, up to 3 options, your recommendation. Note that approving means running: devos-run \"<the improvement>\" $RABS." > "$RUN/report.out" 2>&1 || true

cat <<DONE

✅ improvement proposal staged for '$slug'
   brief: $RUN/improve-brief.md
   spec : $RUN/improve-spec.md
   approve & build:  devos-run "<the improvement>" $RABS
DONE
